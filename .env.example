# Copy to core/.env and fill in. core/config.py reads only core/.env; a .env
# at the repo root is never read. .env files are gitignored, never commit one.
#
# Nothing is checked at start-up. Telegram is needed to receive the digest.
# Gmail (IMAP) is needed only to read saved drafts and for the application
# tracker; without it the run logs a warning and continues. Anthropic is
# needed only for cover letters. Every job board key is optional, and a
# missing key skips that one source.

# ---------------------------------------------------------------------------
# Who the letters are from, used for the cover-letter signature, and the
# prefix used to shorten CV names into labels. Kept out of the code on purpose.
# ---------------------------------------------------------------------------
CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_LINKEDIN=

# Prefix stripped from CV names when building a label.
# With CV_FILENAME_PREFIX=Jane_Doe_CV_ the name
# Jane_Doe_CV_Sales_Engineer.pdf displays as "Sales Engineer".
CV_FILENAME_PREFIX=

# Where you can pursue work authorization. Only ANY (or WORLDWIDE, GLOBAL)
# and EU or EEA are understood; any other value has no effect. A role asking
# only for generic authorization ("must be authorized to work in ...") is kept
# everywhere with ANY, kept only when located in the EU / EEA (a Europe or EMEA
# location counts) with EU or EEA, and dropped otherwise, unless the advert has
# a worldwide signal. A refusal to sponsor or a citizenship lock ("US citizens
# only") always drops. A residency lock ("green card required", "right to work
# in the UK") drops unless the advert offers sponsorship. Otherwise an explicit
# sponsorship offer keeps the job.
#   ANY        willing to pursue a permit anywhere (keep such roles everywhere)
#   EU,EEA     keep them only when the role is in the EU / EEA
#   (blank)    strict: keep only with explicit sponsorship or a worldwide
#              signal ("Worldwide" or "Anywhere" as the location, or "remote
#              worldwide", "hiring globally" in the advert). A plain "Remote"
#              location is not enough.
# Leave blank if unsure. This is personal to you; .env is never committed.
WORK_ELIGIBLE_REGIONS=

# Countries you can work in, read from each job's location field. ISO codes
# plus the group tokens EU, EEA and EUROPE (EUROPE means Europe-wide wording
# such as "Remote - Europe" or "EMEA"). A job located only elsewhere is
# dropped, unless it is remote and the advert says plainly it is open
# worldwide. A location that names no country ("Remote", a bare city) is left
# to the rules above. Blank turns the check off. Example: EU,EEA,GB,CH,EUROPE
ALLOWED_COUNTRIES=
# Countries where a job is worth it only with explicit visa sponsorship, as
# ISO codes, e.g. US. A job located there without a sponsorship offer is
# dropped, and an advert requiring existing work authorization there is
# dropped wherever it is located, unless the job sits in one of your
# ALLOWED_COUNTRIES. Blank turns it off.
SPONSORSHIP_ONLY_COUNTRIES=
# Countries or cities to rule out entirely, remote or on-site, comma
# separated, matched as whole words against the location field only.
# Blank drops nothing.
EXCLUDED_LOCATIONS=
# Languages you do not speak fluently, as English names, comma separated, e.g.
# german,dutch,french. An advert requiring one fluent or at C1 or above is
# dropped; B1 or B2, or "a plus", is kept. Blank turns the check off.
NON_FLUENT_LANGUAGES=
# Languages you cannot read an advert in, as English names, comma separated,
# e.g. slovak,czech,french. An advert written in one is dropped. The language
# is read from the advert's common words; a short or mixed advert, one in
# Cyrillic, or one that names English as the working language is kept.
# Serbian, Croatian and Bosnian read as one language, listed as any of the
# three. Blank turns the check off.
UNREADABLE_ADVERT_LANGUAGES=
# Title words for job functions you never apply to, comma separated, matched
# as whole words with accents ignored, e.g. payroll,recruiter,hr,marketing.
# A job whose title contains one is dropped. Blank drops nothing.
EXCLUDED_TITLE_TERMS=
# 1 drops Serbian, Croatian and Bosnian technician, electrician and
# civil-engineering titles (tehnicar, elektricar, gradjevinski), and English
# or German technician and electrician titles that name no engineer
# (Facility Technician, Elektroniker). Blank is off.
DROP_LOCAL_TRADE_TITLES=

# ---------------------------------------------------------------------------
# Gmail, IMAP. Reads job links you saved as drafts, and is the first inbox
# the application tracker scans. Needs an app password, not your account
# password. Google Account, Security, 2-Step Verification, App passwords.
# Nothing in this project sends email.
# ---------------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional second account, used only by the application tracker.
GMAIL_USER_2=
GMAIL_APP_PASSWORD_2=

# ---------------------------------------------------------------------------
# Telegram. Delivers the daily digest. Both values are needed.
# Create a bot with @BotFather for the token.
# Message the bot once, then run get_chat_id.py for the chat id.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Anthropic. Cover letters only (write_cover_letters.py).
# https://console.anthropic.com/
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Job board APIs, all optional
# ---------------------------------------------------------------------------

# JSearch via RapidAPI
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# Adzuna. https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble. https://jooble.org/api/about
JOOBLE_API_KEY=

# Reed, UK jobs. https://www.reed.co.uk/developers
REED_API_KEY=

# Apify, three actors: LinkedIn listings with full descriptions, a list-only
# Indeed search, and a page crawler enrich_email_jobs.py uses for
# JavaScript-heavy pages. https://apify.com/
APIFY_API_KEY=

# SerpAPI, for Google Jobs. https://serpapi.com/ (free tier 250 searches/month)
# Leave SERPAPI_KEY blank to turn SerpApi off.
SERPAPI_KEY=
# Targets to query, comma separated. "remote" (also "anywhere" or "worldwide")
# adds a fully-remote-anywhere pass, run first. Each country is searched with
# its own gl/domain/hl. Supported codes: de, at, fr, nl, be, dk, gb, us. Any
# other code is skipped with a warning. Empty runs a single remote-anywhere
# pass. Example: remote,de,at,fr,nl,be,dk
SERPAPI_COUNTRIES=
# Caps SerpApi searches per run, one search per query and target pair. If the
# line is missing the code uses 6; this example sets 7. 0 removes the cap.
# Keep a number here: under Docker a blank value stops the run.
SERPAPI_BUDGET=7
# Curated queries for the market passes, comma separated. Google Jobs is query
# sensitive, so a fixed list of terms known to return beats the CV queries.
# Rotated daily so the budget covers a different term each day. Empty falls back
# to the CV-derived queries. Example: mechanical engineer,process engineer,engineer
SERPAPI_QUERIES=

# ---------------------------------------------------------------------------
# Regional sources and the regional digest, all off when blank
# ---------------------------------------------------------------------------
# Terms that put a stored job in the regional message, matched as whole words
# against its location, case and accents ignored. Add city names as well as
# the country for reliable matching.
REGIONAL_MATCH_TERMS=
# Countries for extra Jooble location searches, as country names. Also the
# fallback for REGIONAL_MATCH_TERMS.
REGIONAL_JOB_LOCATIONS=
# Queries for the regional passes, comma separated. Blank uses the CV queries.
REGIONAL_QUERIES=
# Local job boards to read. Only "infostud" is built.
REGIONAL_BOARDS=
# Cities to search the infostud board in, as they appear in its URLs.
# Blank searches the whole country.
INFOSTUD_CITIES=
# Header of the regional message. Blank shows "Regional jobs".
REGIONAL_DIGEST_LABEL=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# Local-language role words that let a title through the title screen, comma separated.
TITLE_SCREEN_TERMS=

# Optional file of jobs you handled outside the digest, never to be sent.
# One "company | title" per line, # for comments. Relative to the core folder.
# Example: data/digest_exclude.txt (the data folder is gitignored).
DIGEST_EXCLUDE_FILE=

# ---------------------------------------------------------------------------
# Daily volume
# ---------------------------------------------------------------------------
# Score a job needs to be sent in the main and direct-company digests, 0 to
# 100. Blank means 15. A day when no digest has a job sends one short message
# naming the bars. The run log prints the score of every job chosen; choose
# the bar from those.
DIGEST_MIN_SCORE=
# Bar for the regional digest. Blank means the same as DIGEST_MIN_SCORE.
# Entry-level software jobs from the local board are lifted to this bar,
# never below 15.
REGIONAL_MIN_SCORE=
# 1 adds graduate, junior, trainee, associate and intern queries for the
# mechanical, process, thermal, CFD and sales engineering tracks your CV
# supports, one of them moved to the front each day. Blank is off.
EARLY_CAREER_QUERIES=
