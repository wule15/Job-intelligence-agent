# Copy to .env and fill in. .env is gitignored, never commit it.
#
# Only the Gmail, Telegram and Anthropic blocks are required. Every job board
# key is optional. A missing key disables that one source and the run
# continues.

# ---------------------------------------------------------------------------
# Who the letters are from. Used for the signature block and to shorten
# CV filenames into readable labels. Kept out of the code on purpose.
# ---------------------------------------------------------------------------
CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_LINKEDIN=

# Prefix stripped from CV filenames when building a label.
# With CV_FILENAME_PREFIX=Jane_Doe_CV_ the file
# Jane_Doe_CV_Sales_Engineer.pdf displays as "Sales Engineer".
CV_FILENAME_PREFIX=

# Where you can pursue work authorization. Controls the work-eligibility
# filter: a role asking only for generic authorization ("must be authorized to
# work in ...") is kept when it sits in a region you list here, and dropped
# otherwise. A hard citizenship or residency lock (e.g. "US citizens only",
# "green card required") always drops, and an explicit sponsorship offer always
# keeps, regardless of this setting.
#   ANY        willing to pursue a permit anywhere (keep such roles everywhere)
#   EU,EEA     keep them only when the role is in the EU / EEA
#   (blank)    strict: keep only with explicit sponsorship or a remote signal
# Leave blank if unsure. This is personal to you; .env is never committed.
WORK_ELIGIBLE_REGIONS=

# Countries you can work in, read from each job's location field. ISO codes
# plus the group tokens EU, EEA and EUROPE (EUROPE means Europe-wide wording
# such as "Remote - Europe" or "EMEA"). A job located only elsewhere is
# dropped. A location that names no country ("Remote", a bare city) is left
# to the rules above. Blank turns the check off. Example: EU,EEA,GB,CH,EUROPE
ALLOWED_COUNTRIES=
# Countries where a job is worth it only with explicit visa sponsorship, as
# ISO codes, e.g. US. A job located there without a sponsorship offer is
# dropped, and an advert requiring existing work authorization there is
# dropped wherever it is. Blank turns it off.
SPONSORSHIP_ONLY_COUNTRIES=
# Languages you do not speak fluently, as English names, comma separated, e.g.
# german,dutch,french. An advert requiring one fluent or at C1 or above is
# dropped; B1 or B2, or "a plus", is kept. Blank turns the check off.
NON_FLUENT_LANGUAGES=
# Languages you cannot read an advert in, as English names, comma separated,
# e.g. slovak,czech,french. An advert written in one is dropped. The language
# is read from the advert's common words; a short or mixed advert is kept.
# Serbian, Croatian and Bosnian read as one language, listed as any of the
# three. Blank turns the check off.
UNREADABLE_ADVERT_LANGUAGES=
# Title words for job functions you never apply to, comma separated, matched
# as whole words with accents ignored, e.g. payroll,recruiter,hr,marketing.
# A job whose title contains one is dropped. Blank drops nothing.
EXCLUDED_TITLE_TERMS=
# 1 drops Serbian, Croatian and Bosnian technician, electrician and
# civil-engineering titles (tehnicar, elektricar, gradjevinski), and English
# or German technician and electrician titles that name no engineer
# (Facility Technician, Elektroniker). Blank is off.
DROP_LOCAL_TRADE_TITLES=

# ---------------------------------------------------------------------------
# Gmail, IMAP. Reads job links you saved as drafts.
# Needs an app password, not your account password.
# Google Account, Security, 2-Step Verification, App passwords.
# ---------------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional second account, used only by the application tracker.
GMAIL_USER_2=
GMAIL_APP_PASSWORD_2=

# ---------------------------------------------------------------------------
# Gmail, SMTP. Sends generated letters to yourself.
# GMAIL_SMTP_USER falls back to GMAIL_USER when blank.
# ---------------------------------------------------------------------------
GMAIL_SMTP_USER=
GMAIL_SMTP_PASSWORD=
RECIPIENT_EMAIL=

# ---------------------------------------------------------------------------
# Telegram. Delivers the daily digest.
# Create a bot with @BotFather for the token.
# Message the bot once, then run get_chat_id.py for the chat id.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Anthropic. Cover letter generation.
# https://console.anthropic.com/
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Job board APIs, all optional
# ---------------------------------------------------------------------------

# JSearch via RapidAPI
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# Adzuna. https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble. https://jooble.org/api/about
JOOBLE_API_KEY=

# Apify, for LinkedIn listings with full descriptions. https://apify.com/
APIFY_API_KEY=

# SerpAPI, for Google Jobs. https://serpapi.com/ (free tier 250 searches/month)
SERPAPI_KEY=
# Targets to query, comma separated. Use "remote" for a fully-remote-anywhere
# pass. Google Jobs is localised, so each country market is searched with its
# own gl/domain/hl. Supported country codes (verified): de, at, fr, nl, be, dk,
# gb, us. Example: remote,de,at,fr,nl,be,dk. Empty means no SerpApi pass.
SERPAPI_COUNTRIES=
# Hard cap on SerpApi searches per run, to stay within the monthly quota.
# Set it to at least the number of targets in SERPAPI_COUNTRIES.
SERPAPI_BUDGET=7
# Curated queries for the market passes, comma separated. Google Jobs is query
# sensitive, so a fixed list of terms known to return beats the CV queries.
# Rotated daily so the budget covers a different term each day. Empty falls back
# to the CV-derived queries. Example: mechanical engineer,process engineer,engineer
SERPAPI_QUERIES=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# Local-language role words that let a title through the title screen, comma separated.
TITLE_SCREEN_TERMS=

# Optional file of jobs you handled outside the digest, never to be sent.
# One "company | title" per line, # for comments. Relative to the core folder.
# Example: data/digest_exclude.txt (the data folder is gitignored).
DIGEST_EXCLUDE_FILE=

# ---------------------------------------------------------------------------
# Daily volume
# ---------------------------------------------------------------------------
# Score a job needs to be sent in the main and direct-company digests, 0 to
# 100. Blank means 15. Slots are a ceiling, so a higher bar sends fewer jobs,
# and a day where nothing clears it sends only a one-line note. The run log
# prints every sent job's score; choose the bar from those.
DIGEST_MIN_SCORE=
# Bar for the regional digest. Blank means the same as DIGEST_MIN_SCORE.
# Entry-level software jobs from the local board are lifted to this bar.
REGIONAL_MIN_SCORE=
# 1 adds graduate, junior, trainee, associate and intern queries for the
# mechanical, process, thermal, CFD and sales engineering tracks your CV
# supports, one of them moved to the front each day. Blank is off.
EARLY_CAREER_QUERIES=
